"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ZOLTAN\"]/mod-"
"append:choice/event/text"
msgstr ""
"\"Les meilleurs constructs de la Croissance Acide, se protégeant "
"vaillamment... et maintenant vous aussi. Méfiante envers les étrangers, "
