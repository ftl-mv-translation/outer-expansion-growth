"anaérobie."

#: src-en/data/events_sector_oe_acid.xml:2589
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_DISTRESS_BROKEN_O2\"]/choice[3]/text"
msgstr "Nous ne pouvons pas aider."

#: src-en/data/events_sector_oe_acid.xml:2591
