msgstr ""
"Un emplacement non visité. Cette balise est située au sein de la Croissance "
"Acide, ce qui peut être préjudiciable à la santé de votre vaisseau."

#: src-en/data/events_sector_oe_acid.xml:2746
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_ORCHID_DISTRESS_PRESSURE\"]/beaconType/visitedTooltip"
msgstr ""

