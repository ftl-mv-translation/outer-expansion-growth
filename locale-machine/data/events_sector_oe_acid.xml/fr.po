"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_WEAPONCACHE\"]/text"
msgstr ""
"Vous arrivez à la balise pour découvrir une cache d'armes dérivante. Au "
"loin, cependant, un vaisseau acide approche. Vous avez assez de temps pour "
"vous éloigner et éviter un combat, ou vous pourriez risquer le combat et "
"attraper l'une des armes."

#: src-en/data/events_sector_oe_acid.xml:2021
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_WEAPONCACHE\"]/choice[1]/text"
msgstr ""

#: src-en/data/events_sector_oe_acid.xml:2023
