#: src-en/data/events_sector_oe_acid.xml:4107
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_BILL_CORE\"]/choice[1]/event/text"
msgstr ""
"\"Laissez-moi accéder aux communications.\" Bill bricole la console, pendant"
" que vous et votre équipage attendez nerveusement. On a presque l'impression"
